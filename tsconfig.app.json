{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": [
    "env.d.ts",
    "src/vite-env.d.ts",
    "src/global.d.ts",
    "src/interfaces/**/*.ts",
    "src/interfaces/**/*.js",
    "src/interfaces/**/*.svelte",
    "src/lib/**/*.ts",
    "src/lib/**/*.js",
    "src/lib/**/*.svelte",
    "scripts/**/*.ts"
  ]
}